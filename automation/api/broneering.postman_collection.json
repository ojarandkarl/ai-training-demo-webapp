{
  "info": {
    "name": "Restful-booker broneering",
    "description": "Session 5 Harjutus 1 API-testid: demo-scenarios/session-4-restful-booker/3_API_testi_kontrollnimekiri.md ja nõuded 1_Broneeringu_nouded_mustand.md. Käivitus: npm run test:api -- automation/api/broneering.postman_collection.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('randomStay')) {",
          "    // Random 2-night stay at least 3 months ahead, so we do not clash with other participants.",
          "    pm.collectionVariables.set('randomStay', JSON.stringify((() => {",
          "    const day = 24 * 60 * 60 * 1000;",
          "    const checkin = new Date(Date.now() + (95 + Math.floor(Math.random() * 200)) * day);",
          "    const iso = (d) => d.toISOString().slice(0, 10);",
          "    return { checkin: iso(checkin), checkout: iso(new Date(checkin.getTime() + 2 * day)) };",
          "    })()));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://restful-booker.herokuapp.com"
    },
    {
      "key": "randomStay",
      "value": ""
    },
    {
      "key": "bookingid",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "A1 Kehtiv broneering salvestatakse nagu saadeti",
      "item": [
        {
          "name": "A1 POST /booking kehtivate andmetega",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "  const stay = JSON.parse(pm.collectionVariables.get('randomStay'));",
                  "  pm.collectionVariables.set('bookingid', '');",
                  "  pm.collectionVariables.set('firstname', 'Test');",
                  "  pm.collectionVariables.set('lastname', 'Koolitus');",
                  "  pm.collectionVariables.set('checkin', stay.checkin);",
                  "  pm.collectionVariables.set('checkout', stay.checkout);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "  const sent = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "  pm.test('A1 status 200', () => pm.response.to.have.status(200));",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('bookingid', json.bookingid || '');",
                  "  pm.collectionVariables.set('a1Sent', JSON.stringify(sent));",
                  "  pm.test('A1 vastuses on bookingid ja saadetud broneering', () => {",
                  "  pm.expect(json.bookingid).to.be.a('number');",
                  "  pm.expect(json.booking).to.eql(sent);",
                  "  });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"{{lastname}}\",\n  \"totalprice\": 240,\n  \"depositpaid\": true,\n  \"bookingdates\": { \"checkin\": \"{{checkin}}\", \"checkout\": \"{{checkout}}\" },\n  \"additionalneeds\": \"Hommikusöök\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "A1 GET salvestatud broneering",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "  if (!pm.collectionVariables.get('bookingid')) {",
                  "  console.log('Skip: previous POST did not return a bookingid, nothing was stored.');",
                  "  pm.execution.skipRequest();",
                  "  }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "  pm.test('A1 GET status 200', () => pm.response.to.have.status(200));",
                  "  pm.test('A1 salvestatud andmed = saadetud andmed', () => {",
                  "  pm.expect(pm.response.json()).to.eql(JSON.parse(pm.collectionVariables.get('a1Sent')));",
                  "  });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingid}}"
              ]
            }
          }
        }
      ]
    },
