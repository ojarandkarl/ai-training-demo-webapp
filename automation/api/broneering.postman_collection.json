        {
          "name": "A6 PUT /booking tokeniga muudab kuupäevi",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "  if (!pm.collectionVariables.get('token') || !pm.collectionVariables.get('bookingid')) {",
                  "    pm.execution.skipRequest();",
                  "  } else {",
                  "    const day = 24 * 60 * 60 * 1000;",
                  "    const checkin = new Date(new Date(pm.collectionVariables.get('checkout')).getTime() + 7 * day);",
                  "    const iso = (d) => d.toISOString().slice(0, 10);",
                  "    pm.collectionVariables.set('newCheckin', iso(checkin));",
